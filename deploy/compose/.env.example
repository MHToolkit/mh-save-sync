MH_SAVE_SYNC_SECRETS_DIR="./secrets"
MH_SAVE_SYNC_HTTP_PORT="18080"
MH_SAVE_SYNC_MINIO_API_PORT="19000"
MH_SAVE_SYNC_MINIO_CONSOLE_PORT="19001"
MH_SAVE_SYNC_DB_HEALTH_INTERVAL="15s"
MH_SAVE_SYNC_MINIO_HEALTH_INTERVAL="15s"
MH_SAVE_SYNC_SERVER_HEALTH_INTERVAL="30s"

# Optional public TLS reverse proxy. For production, point DNS at this host,
# expose only 80/443 publicly, and bind the direct API port to localhost.
MH_SAVE_SYNC_PUBLIC_HOST="localhost"
MH_SAVE_SYNC_PUBLIC_HTTP_PORT="80"
MH_SAVE_SYNC_PUBLIC_HTTPS_PORT="443"
MH_SAVE_SYNC_TLS_HEALTH_INTERVAL="30s"
# MH_SAVE_SYNC_HTTP_PORT="127.0.0.1:18080"
