<Window
    x:Class="MHToolkit.MH3GSaveConverter.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="MH3G Save Converter">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="RootGrid_Loaded">
        <controls:NavigationView x:Name="AppNavigation"
                                 PaneDisplayMode="LeftCompact"
                                 IsBackButtonVisible="Collapsed"
                                 IsSettingsVisible="False"
                                 SelectionChanged="AppNavigation_SelectionChanged"
                                 AutomationProperties.Name="MH3G Save Converter navigation">
            <controls:NavigationView.PaneHeader>
                <StackPanel Margin="8,8,8,16" Orientation="Horizontal" Spacing="10">
                    <Border Width="32" Height="32" CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <SymbolIcon Symbol="Switch" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MH3G" FontWeight="SemiBold" />
                        <TextBlock Text="Save Converter" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </controls:NavigationView.PaneHeader>
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="ConvertNavigationItem" Tag="convert"
                                             Content="{Binding Copy.NavigationConvert}"
                                             AutomationProperties.AutomationId="mh3g.converter.windows.navigation.convert">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Switch" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="HistoryNavigationItem" Tag="history"
                                             Content="{Binding Copy.NavigationHistory}"
                                             AutomationProperties.AutomationId="mh3g.converter.windows.navigation.history">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItemSeparator />
                <controls:NavigationViewItem x:Name="CecNavigationItem" Tag="cec"
                                             Content="{Binding Copy.NavigationExperimentalCec}"
                                             AutomationProperties.AutomationId="mh3g.converter.windows.navigation.experimentalCEC">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Mail" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="SettingsNavigationItem" Tag="settings"
                                             Content="{Binding Copy.NavigationSettings}"
                                             AutomationProperties.AutomationId="mh3g.converter.windows.navigation.settings">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <Grid Padding="24,16,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Copy.AppTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Click="About_Click" Style="{StaticResource QuietButtonStyle}"
                                AutomationProperties.Name="{Binding Copy.AboutUpdates}">
                            <SymbolIcon Symbol="Help" />
                        </Button>
                        <ComboBox x:Name="LanguagePicker" MinWidth="150"
                                  SelectionChanged="LanguagePicker_SelectionChanged"
                                  AutomationProperties.Name="{Binding Copy.Language}">
                            <ComboBoxItem Tag="system" Content="{Binding Copy.LanguageSystem}" />
                            <ComboBoxItem Tag="zh-Hans" Content="{Binding Copy.LanguageChinese}" />
                            <ComboBoxItem Tag="en" Content="{Binding Copy.LanguageEnglish}" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Convert / Step 1 -->
                    <Grid x:Name="InputPage" Visibility="Visible">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CoreWorkflowAnchor" MaxWidth="900" HorizontalAlignment="Center" Spacing="16" Padding="0,18,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Copy.InputPageTitle}" Style="{StaticResource PageTitleTextStyle}"
                                                   AutomationProperties.AutomationId="mh3g.converter.windows.page.input.title" />
                                        <TextBlock Text="{Binding Copy.InputPageDescription}" Style="{StaticResource SectionCaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Copy.StepOne}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <InfoBar IsOpen="{Binding IsSyntheticFixture}" IsClosable="False" Severity="Informational"
                                         Message="{Binding Copy.SyntheticFixtureNotice}" />
                                <Border Style="{StaticResource WorkSurfaceStyle}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Copy.ConversionModeTitle}" FontWeight="SemiBold" />
                                                <ComboBox x:Name="ConversionModePicker" SelectionChanged="ConversionModePicker_SelectionChanged">
                                                    <ComboBoxItem Tag="new" Content="{Binding Copy.ConversionModeNew}" />
                                                    <ComboBoxItem Tag="repair" Content="{Binding Copy.ConversionModeRepair}" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="{Binding Copy.SaveSlot}" FontWeight="SemiBold" />
                                                <ComboBox ItemsSource="{Binding SaveSlots}" SelectedItem="{Binding SelectedSlot, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="6" Visibility="{Binding RepairCurrentVisibility}">
                                                <TextBlock Text="{Binding Copy.RepairVersionTitle}" FontWeight="SemiBold" />
                                                <ComboBox x:Name="RepairVersionPicker" MinWidth="160" SelectionChanged="RepairVersionPicker_SelectionChanged">
                                                    <ComboBoxItem Tag="auto" Content="{Binding Copy.RepairVersionAutomatic}" />
                                                    <ComboBoxItem Tag="0.0.3" Content="0.0.3" /><ComboBoxItem Tag="0.0.4" Content="0.0.4" />
                                                    <ComboBoxItem Tag="0.0.5" Content="0.0.5" /><ComboBoxItem Tag="0.0.6" Content="0.0.6" />
                                                </ComboBox>
                                                <TextBlock Text="{Binding RepairDetectionSummary}" Style="{StaticResource SectionCaptionTextStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Copy.SourceSlot}" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="SourcePathBox" Style="{StaticResource PathTextBoxStyle}" Text="{Binding SourcePath, Mode=TwoWay}" TextChanged="CorePath_TextChanged"
                                                     PlaceholderText="user1 / user2 / user3" AutomationProperties.AutomationId="mh3g.converter.windows.path.source" />
                                            <Button Grid.Column="1" Click="ChooseSourceFile_Click" Style="{StaticResource QuietButtonStyle}"
                                                    AutomationProperties.AutomationId="mh3g.converter.windows.action.chooseSource"><SymbolIcon Symbol="OpenFile" /></Button>
                                            <Button Grid.Column="2" Click="ChooseSourceFolder_Click" Style="{StaticResource QuietButtonStyle}"><SymbolIcon Symbol="Folder" /></Button>
                                        </Grid>
                                        <TextBlock Text="{Binding SourcePathPreview}" Style="{StaticResource SectionCaptionTextStyle}" />

                                        <StackPanel Spacing="8" Visibility="{Binding RepairCurrentVisibility}">
                                            <TextBlock Text="{Binding Copy.CurrentSlot}" FontWeight="SemiBold" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox x:Name="CurrentPathBox" Style="{StaticResource PathTextBoxStyle}" Text="{Binding CurrentPath, Mode=TwoWay}" TextChanged="CorePath_TextChanged"
                                                         PlaceholderText="converted Wii U / Cemu user#" AutomationProperties.AutomationId="mh3g.converter.windows.path.current" />
                                                <Button Grid.Column="1" Click="ChooseCurrentFile_Click" Style="{StaticResource QuietButtonStyle}"><SymbolIcon Symbol="OpenFile" /></Button>
                                                <Button Grid.Column="2" Click="ChooseCurrentFolder_Click" Style="{StaticResource QuietButtonStyle}"><SymbolIcon Symbol="Folder" /></Button>
                                            </Grid>
                                            <TextBlock Text="{Binding CurrentPathPreview}" Style="{StaticResource SectionCaptionTextStyle}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding CoreTargetTitle}" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="TargetPathBox" Style="{StaticResource PathTextBoxStyle}" Text="{Binding TargetPath, Mode=TwoWay}" TextChanged="CorePath_TextChanged"
                                                     PlaceholderText="{Binding CoreTargetPlaceholder}" AutomationProperties.AutomationId="mh3g.converter.windows.path.output" />
                                            <Button Grid.Column="1" Click="ChooseTargetFile_Click" Style="{StaticResource QuietButtonStyle}"
                                                    AutomationProperties.AutomationId="mh3g.converter.windows.action.chooseOutput"><SymbolIcon Symbol="OpenFile" /></Button>
                                            <Button Grid.Column="2" Click="ChooseTargetFolder_Click" Style="{StaticResource QuietButtonStyle}"><SymbolIcon Symbol="Folder" /></Button>
                                        </Grid>
                                        <TextBlock Text="{Binding TargetPathPreview}" Style="{StaticResource SectionCaptionTextStyle}" />

                                        <Expander Header="{Binding Copy.AdvancedDetails}">
                                            <StackPanel Spacing="10" Padding="0,10,0,0">
                                                <TextBlock Text="{Binding Copy.CliPath}" FontWeight="SemiBold" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="CliPathBox" Text="{Binding CliPath, Mode=TwoWay}" />
                                                    <Button Grid.Column="1" Click="ChooseCli_Click" Content="{Binding Copy.Browse}" />
                                                </Grid>
                                                <TextBlock Text="{Binding ConversionModeDescription}" Style="{StaticResource SectionCaptionTextStyle}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource WorkSurfaceStyle}" Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Copy.InputMissingReason}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                               AutomationProperties.AutomationId="mh3g.converter.windows.state.inputMissing" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="Inspect_Click" IsEnabled="{Binding CanInspectCore}" Style="{StaticResource AccentButtonStyle}"
                                        AutomationProperties.AutomationId="mh3g.converter.windows.action.inspect" Content="{Binding Copy.Inspect}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Convert / Step 2 -->
                    <Grid x:Name="OptionalPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OptionalConfigurationAnchor" MaxWidth="900" HorizontalAlignment="Center" Spacing="16" Padding="0,18,0,24">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6"><TextBlock Text="{Binding Copy.OptionalPageTitle}" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.page.optionals.title" /><TextBlock Text="{Binding Copy.OptionalPageDescription}" Style="{StaticResource SectionCaptionTextStyle}" /></StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Copy.StepTwo}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding Copy.OptionalCoreUnaffected}" />
                                <Border Style="{StaticResource WorkSurfaceStyle}">
                                    <StackPanel Spacing="12">
                                        <ToggleSwitch x:Name="SystemToggle" Header="{Binding Copy.SharedSystem}" IsOn="{Binding IsSystemEnabled, Mode=TwoWay}" Toggled="SystemToggle_Toggled" />
                                        <StackPanel x:Name="SystemControls" Visibility="Collapsed" Spacing="9">
                                            <TextBlock Text="{Binding Copy.SystemMergeWarning}" Style="{StaticResource SectionCaptionTextStyle}" />
                                            <TextBox x:Name="SystemSourceBox" Text="{Binding SystemSourcePath, Mode=TwoWay}" TextChanged="SystemPath_TextChanged" PlaceholderText="3DS system" AutomationProperties.AutomationId="mh3g.converter.windows.path.systemSource" />
                                            <TextBox x:Name="SystemTargetBox" Text="{Binding SystemTargetPath, Mode=TwoWay}" TextChanged="SystemPath_TextChanged" PlaceholderText="Cemu system" AutomationProperties.AutomationId="mh3g.converter.windows.path.systemTarget" />
                                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ChooseSystemSource_Click" Content="{Binding Copy.SystemSource}" /><Button Click="ChooseSystemTarget_Click" Content="{Binding Copy.SystemTarget}" /><Button Click="SystemDryRun_Click" IsEnabled="{Binding CanRunSystemDryRun}" Content="{Binding Copy.RunSystemDryRun}" /><Button Click="WriteSystem_Click" IsEnabled="{Binding CanWriteSystem}" Content="{Binding Copy.WriteSystem}" /></StackPanel>
                                            <TextBox x:Name="SystemRollbackManifestBox" Text="{Binding SystemRollbackManifestPath, Mode=TwoWay}" PlaceholderText="{Binding Copy.SystemManifest}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ChooseSystemRollbackManifest_Click" Content="{Binding Copy.Browse}" /><Button Click="RollbackSystem_Click" IsEnabled="{Binding CanRollbackSystem}" Content="{Binding Copy.RollbackFromManifest}" /></StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource WorkSurfaceStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding Copy.OptionalExtData}" Style="{StaticResource SectionTitleTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="18"><CheckBox x:Name="GuildCardsCheckBox" Content="{Binding Copy.GuildCards}" IsChecked="{Binding IncludeGuildCards, Mode=TwoWay}" /><CheckBox x:Name="QuestsCheckBox" Content="{Binding Copy.Quests}" IsChecked="{Binding IncludeQuests, Mode=TwoWay}" /></StackPanel>
                                        <TextBox x:Name="ExtrasSourceBox" Text="{Binding ExtrasSourceDirectory, Mode=TwoWay}" TextChanged="ExtrasPath_TextChanged" PlaceholderText="3DS ExtData user" AutomationProperties.AutomationId="mh3g.converter.windows.path.extdataSource" />
                                        <TextBox x:Name="ExtrasStagingBox" Text="{Binding ExtrasStagingDirectory, Mode=TwoWay}" TextChanged="ExtrasPath_TextChanged" PlaceholderText="Staging directory" />
                                        <TextBox x:Name="ExtrasTargetBox" Text="{Binding ExtrasTargetDirectory, Mode=TwoWay}" TextChanged="ExtrasPath_TextChanged" PlaceholderText="Cemu ExtData target" AutomationProperties.AutomationId="mh3g.converter.windows.path.extdataTarget" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ChooseExtrasSource_Click" Content="{Binding Copy.ExtDataSource}" /><Button Click="ChooseExtrasStaging_Click" Content="{Binding Copy.StagingDirectory}" /><Button Click="ChooseExtrasTarget_Click" Content="{Binding Copy.ExtDataTarget}" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ExtrasStageDryRun_Click" IsEnabled="{Binding CanRunExtrasStageDryRun}" Content="{Binding Copy.PreviewStaging}" /><Button Click="StageExtras_Click" IsEnabled="{Binding CanStageExtras}" Content="{Binding Copy.WriteStaging}" /><Button Click="ExtrasInstallDryRun_Click" IsEnabled="{Binding CanRunExtrasInstallDryRun}" Content="{Binding Copy.PreviewInstall}" /><Button Click="InstallExtras_Click" IsEnabled="{Binding CanInstallExtras}" Content="{Binding Copy.InstallExtData}" /></StackPanel>
                                        <TextBox x:Name="ExtrasRollbackManifestBox" Text="{Binding ExtrasRollbackManifestPath, Mode=TwoWay}" PlaceholderText="{Binding Copy.ExtDataManifest}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ChooseExtrasRollbackManifest_Click" Content="{Binding Copy.Browse}" /><Button Click="RollbackExtras_Click" IsEnabled="{Binding CanRollbackExtras}" Content="{Binding Copy.RollbackFromManifest}" /></StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource WorkSurfaceStyle}" Padding="16,12">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Copy.OptionalCoreUnaffected}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                <Button Grid.Column="1" Click="SkipOptional_Click" Content="{Binding Copy.SkipOptionalData}" AutomationProperties.AutomationId="mh3g.converter.windows.action.skipOptional" />
                                <Button Grid.Column="2" Click="ContinueToDryRun_Click" Content="{Binding Copy.ContinueToDryRun}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.action.continueOptionals" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Convert / Step 3 -->
                    <Grid x:Name="DryRunPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer><StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="16" Padding="0,18,0,24">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="{Binding Copy.DryRunPageTitle}" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.page.dryRun.title" /><TextBlock Text="{Binding Copy.DryRunDescription}" Style="{StaticResource SectionCaptionTextStyle}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Copy.StepThree}" /></Grid>
                            <Border Style="{StaticResource WorkSurfaceStyle}"><StackPanel Spacing="12"><InfoBar IsOpen="True" IsClosable="False" Severity="Success" Message="{Binding Copy.DryRunReadyMessage}" AutomationProperties.AutomationId="mh3g.converter.windows.state.dryRunReady" /><TextBlock Text="{Binding SourcePathPreview}" /><TextBlock Text="{Binding CurrentPathPreview}" Visibility="{Binding RepairCurrentVisibility}" /><TextBlock Text="{Binding TargetPathPreview}" /><ProgressBar IsIndeterminate="True" Visibility="{Binding BusyVisibility}" /></StackPanel></Border>
                            <Expander Header="{Binding Copy.AdvancedDetails}"><TextBlock Text="{Binding LatestReport}" FontFamily="Cascadia Mono" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Expander>
                        </StackPanel></ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource WorkSurfaceStyle}" Padding="16,12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Copy.DryRunNeedsInspect}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="mh3g.converter.windows.state.dryRunBlocked" /><Button Grid.Column="1" Click="DryRun_Click" IsEnabled="{Binding CanRunCoreDryRun}" Content="{Binding Copy.RunDryRun}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.action.runDryRun" /></Grid></Border>
                    </Grid>

                    <!-- Convert / Step 4 -->
                    <Grid x:Name="WriteResultPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer><StackPanel x:Name="ResultAnchor" MaxWidth="900" HorizontalAlignment="Center" Spacing="16" Padding="0,18,0,24">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="{Binding Copy.WriteResultPageTitle}" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.page.writeResult.title" /><TextBlock Text="{Binding Copy.WriteDescription}" Style="{StaticResource SectionCaptionTextStyle}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Copy.StepFour}" /></Grid>
                            <InfoBar IsOpen="{Binding HasLatestError}" IsClosable="True" Severity="Error" Title="{Binding Copy.Failed}" Message="{Binding LatestError}" AutomationProperties.AutomationId="mh3g.converter.windows.state.failure" />
                            <Border Style="{StaticResource WorkSurfaceStyle}"><StackPanel Spacing="10"><TextBlock Text="{Binding StatusText}" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="mh3g.converter.windows.state.success" /><TextBlock Text="{Binding Copy.WriteAuthorizedMessage}" TextWrapping="Wrap" /><TextBlock Text="{Binding LatestReport}" FontFamily="Cascadia Mono" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><ProgressBar IsIndeterminate="True" Visibility="{Binding BusyVisibility}" /></StackPanel></Border>
                            <Border Style="{StaticResource WorkSurfaceStyle}"><StackPanel Spacing="10"><TextBlock Text="{Binding Copy.RollbackTitle}" Style="{StaticResource SectionTitleTextStyle}" /><TextBox x:Name="RollbackManifestBox" Text="{Binding RollbackManifestPath, Mode=TwoWay}" PlaceholderText="{Binding Copy.ManifestPath}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ChooseRollbackManifest_Click" Content="{Binding Copy.Browse}" /><Button Click="RollbackCore_Click" IsEnabled="{Binding CanRollbackCore}" Content="{Binding Copy.RollbackFromManifest}" AutomationProperties.AutomationId="mh3g.converter.windows.action.rollback" /></StackPanel></StackPanel></Border>
                        </StackPanel></ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource WorkSurfaceStyle}" Padding="16,12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Copy.WriteAuthorizedMessage}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="mh3g.converter.windows.state.writeAuthorized" /><Button Grid.Column="1" Click="WriteCore_Click" IsEnabled="{Binding CanWriteCore}" Content="{Binding Copy.ConfirmAndWrite}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.action.confirmWrite" /></Grid></Border>
                    </Grid>

                    <!-- History -->
                    <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed"><StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="16" Padding="0,18,0,24"><TextBlock Text="{Binding Copy.HistoryPageTitle}" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.page.history.title" /><Border Style="{StaticResource WorkSurfaceStyle}"><StackPanel Spacing="12"><StackPanel Spacing="12" Visibility="{Binding HistoryEmptyVisibility}"><SymbolIcon Symbol="Document" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Text="{Binding Copy.HistoryEmptyTitle}" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.state.historyEmpty" /><TextBlock Text="{Binding Copy.HistoryEmptyDescription}" Style="{StaticResource SectionCaptionTextStyle}" /><Button HorizontalAlignment="Left" Click="StartConversion_Click" Content="{Binding Copy.StartConversion}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.action.startConversion" /></StackPanel><ListView ItemsSource="{Binding History}" Visibility="{Binding HistoryListVisibility}"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,8" Spacing="3"><TextBlock Text="{Binding Operation}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" /><TextBlock Text="{Binding Timestamp}" FontSize="12" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></StackPanel></ScrollViewer>

                    <!-- Experimental CEC -->
                    <ScrollViewer x:Name="CecPage" Visibility="Collapsed"><StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="16" Padding="0,18,0,24"><TextBlock Text="{Binding Copy.ExperimentalCec}" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.page.experimentalCEC.title" /><InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="{Binding Copy.ExperimentalCecHint}" /><Border Style="{StaticResource WorkSurfaceStyle}"><StackPanel Spacing="10"><ToggleSwitch x:Name="CecToggle" Header="{Binding Copy.ExperimentalCec}" IsOn="{Binding IsCecEnabled, Mode=TwoWay}" Toggled="CecToggle_Toggled" /><StackPanel x:Name="CecControls" Visibility="Collapsed" Spacing="10"><TextBox x:Name="CecSourceBox" Text="{Binding CecSourceDirectory, Mode=TwoWay}" TextChanged="CecPath_TextChanged" PlaceholderText="{Binding Copy.CecSourceDirectory}" AutomationProperties.AutomationId="mh3g.converter.windows.path.cecSource" /><TextBox x:Name="CecTargetBox" Text="{Binding CecTargetPath, Mode=TwoWay}" TextChanged="CecPath_TextChanged" PlaceholderText="{Binding Copy.CecTargetCache}" AutomationProperties.AutomationId="mh3g.converter.windows.path.cecTarget" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ChooseCecDirectory_Click" Content="{Binding Copy.CecSourceDirectory}" /><Button Click="ChooseCecTarget_Click" Content="{Binding Copy.CecTargetCache}" /><Button Click="InspectCec_Click" IsEnabled="{Binding CanInspectCec}" Content="{Binding Copy.InspectCec}" /><Button Click="CecDryRun_Click" IsEnabled="{Binding CanRunCecDryRun}" Content="{Binding Copy.RunCecDryRun}" /></StackPanel><CheckBox Content="{Binding Copy.CecAcknowledge}" IsChecked="{Binding IsCecAcknowledged, Mode=TwoWay}" /><Button HorizontalAlignment="Left" Click="WriteCec_Click" IsEnabled="{Binding CanWriteCec}" Content="{Binding Copy.WriteCec}" /><TextBox x:Name="CecRollbackManifestBox" Text="{Binding CecRollbackManifestPath, Mode=TwoWay}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="ChooseCecRollbackManifest_Click" Content="{Binding Copy.Browse}" /><Button Click="RollbackCec_Click" IsEnabled="{Binding CanRollbackCec}" Content="{Binding Copy.RollbackCec}" /></StackPanel></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="16" Padding="0,18,0,24"><TextBlock Text="{Binding Copy.SettingsPageTitle}" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.AutomationId="mh3g.converter.windows.page.settings.title" /><Border Style="{StaticResource WorkSurfaceStyle}"><StackPanel Spacing="14"><TextBlock Text="{Binding Copy.Language}" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="{Binding Copy.UpdateNetworkNote}" Style="{StaticResource SectionCaptionTextStyle}" /><Button HorizontalAlignment="Left" Click="About_Click" Content="{Binding Copy.AboutUpdates}" /></StackPanel></Border></StackPanel></ScrollViewer>
                </Grid>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
