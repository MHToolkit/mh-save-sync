<UserControl
    x:Class="MHToolkit.MH3GSaveConverter.Windows.Controls.StageArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MHToolkit.MH3GSaveConverter.Windows.Controls">
    <Border MinHeight="278" CornerRadius="8" Background="#FFF4F7FB">
        <Grid>
        <Image x:Name="SceneImage" Source="ms-appx:///assets/Artwork/input-route.png" Stretch="UniformToFill" Opacity="0.28" IsHitTestVisible="False" />
        <Canvas Opacity="0.8">
            <Path x:Name="InputRoute" Fill="#1A0A7AFF" Data="M0,32 L620,0 L620,58 L0,102 Z" />
            <Path x:Name="InspectRoute" Fill="#1A1B8A6B" Data="M0,170 L620,96 L620,154 L0,240 Z" Visibility="Collapsed" />
            <Path x:Name="DryRunRoute" Fill="#1AE86552" Data="M0,250 L620,170 L620,230 L0,315 Z" Visibility="Collapsed" />
            <Path x:Name="WriteRoute" Fill="#1A526175" Data="M0,92 L620,50 L620,112 L0,154 Z" Visibility="Collapsed" />
            <Line X1="28" Y1="226" X2="570" Y2="80" Stroke="#660A7AFF" StrokeThickness="3" StrokeDashArray="2,8" />
            <Ellipse Width="9" Height="9" Fill="#FF1B8A6B" Canvas.Left="121" Canvas.Top="191" />
            <Ellipse Width="9" Height="9" Fill="#FFE86552" Canvas.Left="290" Canvas.Top="147" />
            <Ellipse Width="9" Height="9" Fill="#FF0A7AFF" Canvas.Left="470" Canvas.Top="99" />
        </Canvas>

        <Grid Margin="30,34,30,28" ColumnSpacing="18" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="20,18" Background="#FFFDFEFF" BorderBrush="#1A18212F" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="7">
                    <TextBlock Text="3DS" FontSize="13" FontWeight="SemiBold" Foreground="#FF526175" />
                    <TextBlock Text="user#" FontSize="28" FontWeight="SemiBold" Foreground="#FF18212F" />
                    <TextBlock Text="{Binding Copy.ArtworkSource}" FontSize="12" Foreground="#FF526175" />
                    <Border Height="4" Width="76" HorizontalAlignment="Left" Background="#FF1B8A6B" CornerRadius="2" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Path Data="M4,24 L34,24 L25,15 M34,24 L25,33" Stroke="#FF0A7AFF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
            <Border Grid.Column="2" Padding="20,18" Background="#FF18212F" CornerRadius="8">
                <StackPanel Spacing="7">
                    <TextBlock Text="WII U / CEMU" FontSize="13" FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                    <TextBlock Text="user#" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding Copy.ArtworkTarget}" FontSize="12" Foreground="#CCFFFFFF" />
                    <Border Height="4" Width="76" HorizontalAlignment="Left" Background="#FFE86552" CornerRadius="2" />
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="StageBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,18" Padding="10,5" Background="#E6FFFFFF" CornerRadius="8">
            <TextBlock x:Name="StageText" Text="INPUT" FontSize="11" FontWeight="SemiBold" Foreground="#FF18212F" />
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StageStates">
                <VisualState x:Name="Input">
                    <VisualState.Setters>
                        <Setter Target="InputRoute.Visibility" Value="Visible" />
                        <Setter Target="StageText.Text" Value="INPUT" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Inspect">
                    <VisualState.Setters>
                        <Setter Target="InspectRoute.Visibility" Value="Visible" />
                        <Setter Target="StageText.Text" Value="INSPECT" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DryRunAuthorized">
                    <VisualState.Setters>
                        <Setter Target="DryRunRoute.Visibility" Value="Visible" />
                        <Setter Target="StageText.Text" Value="DRY RUN" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Write">
                    <VisualState.Setters>
                        <Setter Target="WriteRoute.Visibility" Value="Visible" />
                        <Setter Target="StageText.Text" Value="WRITE" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        </Grid>
    </Border>
</UserControl>
